---
// Fig. 1: career drawn as a time series. Pure SVG rendered at build time;
// a few lines of JS add a crosshair readout on hover/tap.
import { timeline } from "../data/profile";
import { formatMonth } from "../lib/format";

const START = { y: 2016, m: 7 };
const END = { y: 2027, m: 12 };
const idx = (iso: string) => {
  const [y, m] = iso.split("-").map(Number);
  return (y - START.y) * 12 + (m - START.m);
};
const now = new Date();
const NOW = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
const TOTAL = (END.y - START.y) * 12 + (END.m - START.m);
const W = 1200;
const x = (iso: string) => (idx(iso) / TOTAL) * W;
const nowX = x(NOW);

// Vertical layout
const Y = {
  axis: 18,
  eduLabel: 54,
  edu: 62,
  indLabel: 116,
  group: 122,
  ind: 132,
  prodLabel: 186,
  prod: 194,
  markLabel: 296,
  mark: 312,
};
const H = 444;
const BAR = 24;
const PROD_BAR = 20;
const PROD_GAP = 6;

const years = Array.from({ length: END.y - START.y }, (_, i) => START.y + 1 + i);

const bars = timeline.bars.map((b) => {
  const x0 = x(b.start);
  const x1 = b.end ? x(b.end) : nowX;
  const y =
    b.lane === "education" ? Y.edu : b.lane === "industry" ? Y.ind : Y.prod + (b.row ?? 0) * (PROD_BAR + PROD_GAP);
  const h = b.lane === "products" ? PROD_BAR : BAR;
  const text = b.short && (x1 - x0) < b.label.length * 7.4 + 14 ? b.short : b.label;
  return { ...b, x0, x1, y, h, text, ongoing: !b.end };
});
// One label row per milestone, latest on top, so leader lines never cross earlier labels.
const marks = timeline.marks.map((m, i, all) => ({ ...m, mx: x(m.date), row: all.length - 1 - i }));
const groups = timeline.groups.map((g) => ({ ...g, gx: x(g.start) }));

// Data for the client-side readout (month indices keep the script tiny).
const data = {
  total: TOTAL,
  start: START,
  now: idx(NOW),
  bars: timeline.bars.map((b) => ({ l: b.detail, s: idx(b.start), e: b.end ? idx(b.end) : idx(NOW), c: b.color ?? null, lane: b.lane })),
  marks: timeline.marks.map((m) => ({ l: m.detail, s: idx(m.date) })),
};
---

<figure class="career" aria-labelledby="fig1-cap">
  <div class="scroller" data-career-scroll>
    <div class="inner">
      <svg viewBox={`0 0 ${W} ${H}`} class="chart" aria-hidden="true" data-career-svg>
        <defs>
          <pattern id="hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <line x1="0" y1="0" x2="0" y2="7" class="hatch-line"></line>
          </pattern>
          <linearGradient id="fade-grad" x1={nowX} x2={W} gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#fff" stop-opacity="0.9"></stop>
            <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
          </linearGradient>
          <mask id="fc-fade" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
            <rect x={nowX} y="0" width={W - nowX} height={H} fill="url(#fade-grad)"></rect>
          </mask>
        </defs>

        <!-- year grid -->
        {
          years.map((yr) => {
            const gx = x(`${yr}-01`);
            return (
              <g>
                <line x1={gx} x2={gx} y1="28" y2={H - 6} class="grid-line" />
                <text x={gx + 4} y={Y.axis} class="t-axis">
                  {yr}
                </text>
              </g>
            );
          })
        }
        <line x1="0" x2={W} y1="28" y2="28" class="axis-line"></line>

        <!-- forecast region -->
        <rect x={nowX} y="28" width={W - nowX} height={H - 34} fill="url(#hatch)" class="fc-region"></rect>
        <text x={nowX + 8} y="46" class="t-fc">Forecast</text>

        <!-- lane labels -->
        <text x="2" y={Y.eduLabel} class="t-lane">Education</text>
        <text x="2" y={Y.indLabel} class="t-lane">Industry</text>
        <text x="2" y={Y.prodLabel} class="t-lane">Products</text>
        <text x="2" y={Y.markLabel} class="t-lane">Milestones</text>

        <!-- group brackets (e.g. Amazon) -->
        {
          groups.map((g) => (
            <g class="group">
              <path d={`M${g.gx} ${Y.group + 6} V${Y.group} H${nowX}`} class="bracket" />
              <path d={`M${nowX} ${Y.group} H${W - 4}`} class="bracket bracket-fc" mask="url(#fc-fade)" />
              <text x={g.gx} y={Y.group - 5} class="t-group">
                {g.label}
              </text>
            </g>
          ))
        }

        <!-- bars -->
        {
          bars.map((b) => (
            <a href={b.href} tabindex="-1" class:list={["bar", `lane-${b.lane}`]}>
              <rect x={b.x0} y={b.y} width={Math.max(2, b.x1 - b.x0 - 1.5)} height={b.h} style={b.color ? `fill:${b.color}` : undefined} />
              {b.ongoing && (
                <rect
                  x={nowX}
                  y={b.y}
                  width={W - nowX - 2}
                  height={b.h}
                  class="bar-fc"
                  style={b.color ? `fill:${b.color}` : undefined}
                  mask="url(#fc-fade)"
                />
              )}
              <text x={b.x0 + 7} y={b.y + b.h / 2 + 4.5} class="t-bar">
                {b.text}
              </text>
            </a>
          ))
        }

        <!-- milestones -->
        <line x1="0" x2={nowX} y1={Y.mark} y2={Y.mark} class="mark-base"></line>
        {
          marks.map((m) => (
            <a href={m.href} tabindex="-1" class="mark">
              <line x1={m.mx} x2={m.mx} y1={Y.mark} y2={Y.mark + 12 + m.row * 19} class="leader" />
              <rect x={m.mx - 5} y={Y.mark - 5} width="10" height="10" transform={`rotate(45 ${m.mx} ${Y.mark})`} class="diamond" />
              <text x={m.mx + 6} y={Y.mark + 20 + m.row * 19} class="t-mark">
                {m.label}
              </text>
            </a>
          ))
        }

        <!-- now -->
        <line x1={nowX} x2={nowX} y1="28" y2={H - 6} class="now-line"></line>
        <text x={nowX - 8} y="46" class="t-now" text-anchor="end">Now · {formatMonth(NOW)}</text>

        <!-- crosshair (driven by JS) -->
        <g class="xhair" data-xhair>
          <line x1="0" x2="0" y1="28" y2={H - 6}></line>
        </g>
      </svg>
      <div class="readout" data-readout hidden>
        <p class="r-date"></p>
        <ul class="r-list"></ul>
      </div>
    </div>
  </div>
  <figcaption id="fig1-cap" class="caption">
    <span class="signal">Fig. 1</span> Career as a time series, 2016 to today. Bars show studies, roles and products; diamonds mark milestones;
    the hatched area is a forecast. <span class="hint">Hover or tap the chart to inspect any month.</span>
  </figcaption>

  <!-- Accessible, crawlable version of the chart -->
  <ol class="sr-only">
    {
      timeline.bars.map((b) => (
        <li>
          <a href={b.href}>{b.detail}</a>: {formatMonth(b.start)} to {b.end ? formatMonth(b.end) : "present"}
        </li>
      ))
    }
    {
      timeline.marks.map((m) => (
        <li>
          {m.detail} ({formatMonth(m.date)})
        </li>
      ))
    }
  </ol>
  <script type="application/json" data-career-data set:html={JSON.stringify(data)} />
</figure>

<script>
  const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  for (const fig of document.querySelectorAll<HTMLElement>(".career")) {
    const data = JSON.parse(fig.querySelector("[data-career-data]")!.textContent!);
    const svg = fig.querySelector<SVGSVGElement>("[data-career-svg]")!;
    const xhair = fig.querySelector<SVGGElement>("[data-xhair]")!;
    const readout = fig.querySelector<HTMLElement>("[data-readout]")!;
    const rDate = readout.querySelector(".r-date")!;
    const rList = readout.querySelector(".r-list")!;
    const scroller = fig.querySelector<HTMLElement>("[data-career-scroll]")!;

    // On narrow screens, start scrolled to the most recent years.
    if (scroller.scrollWidth > scroller.clientWidth) scroller.scrollLeft = scroller.scrollWidth;

    const label = (i: number) => {
      const m = (data.start.m - 1 + i) % 12;
      const y = data.start.y + Math.floor((data.start.m - 1 + i) / 12);
      return `${MONTHS[m]} ${y}`;
    };

    const show = (clientX: number) => {
      const rect = svg.getBoundingClientRect();
      const fx = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
      const i = Math.round(fx * data.total);
      xhair.style.transform = `translateX(${fx * 1200}px)`;
      xhair.classList.add("on");
      const future = i > data.now;
      const items = data.bars.filter((b: any) => i >= b.s && i <= (future ? data.total : b.e) && (!future || b.e === data.now));
      const marks = data.marks.filter((m: any) => Math.abs(m.s - i) <= 1);
      rDate.textContent = future ? `${label(i)} · forecast` : label(i);
      rList.innerHTML = "";
      for (const b of items) {
        const li = document.createElement("li");
        li.textContent = b.l;
        if (b.c) li.style.setProperty("--dot", b.c);
        li.dataset.lane = b.lane;
        rList.append(li);
      }
      for (const m of marks) {
        const li = document.createElement("li");
        li.textContent = m.l;
        li.dataset.lane = "mark";
        rList.append(li);
      }
      if (!items.length && !marks.length) {
        const li = document.createElement("li");
        li.textContent = "School, before all this";
        li.dataset.lane = "none";
        rList.append(li);
      }
      readout.hidden = false;
      const inner = readout.parentElement!.getBoundingClientRect();
      const px = clientX - inner.left;
      const w = readout.offsetWidth;
      readout.style.left = `${px + 16 + w > inner.width ? px - w - 16 : px + 16}px`;
    };
    const hide = () => {
      readout.hidden = true;
      xhair.classList.remove("on");
    };
    svg.addEventListener("pointermove", (e) => show(e.clientX));
    svg.addEventListener("pointerdown", (e) => show(e.clientX));
    svg.addEventListener("pointerleave", (e) => {
      if (e.pointerType === "mouse") hide();
    });
  }
</script>

<style>
  .career {
    position: relative;
  }
  .scroller {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
  }
  .inner {
    position: relative;
    min-width: 980px;
  }
  .chart {
    width: 100%;
    touch-action: pan-x;
    user-select: none;
    cursor: crosshair;
  }
  .grid-line {
    stroke: var(--hair);
    stroke-width: 1;
  }
  .axis-line {
    stroke: var(--rule);
    stroke-width: 1.5;
  }
  .t-axis,
  .t-lane,
  .t-group,
  .t-now,
  .t-fc,
  .t-mark {
    font-family: var(--mono);
    font-size: 12px;
    fill: var(--ink-3);
    letter-spacing: 0.04em;
  }
  .t-lane {
    text-transform: uppercase;
    font-size: 11px;
    fill: var(--ink-3);
  }
  .t-group {
    text-transform: uppercase;
    fill: var(--ink);
    font-weight: 500;
  }
  .t-now {
    fill: var(--signal);
    text-transform: uppercase;
    font-weight: 500;
  }
  .t-fc {
    text-transform: uppercase;
    fill: var(--ink-3);
  }
  .t-mark {
    fill: var(--ink-2);
    font-size: 11.5px;
  }
  .hatch-line {
    stroke: var(--ink-3);
    stroke-width: 1;
    opacity: 0.22;
  }
  .bracket {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .bracket-fc {
    stroke-dasharray: 3 4;
  }
  .bar rect {
    transition: opacity 0.15s;
  }
  .lane-education rect:not(.bar-fc) {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .lane-industry rect {
    fill: var(--ink);
  }
  .bar-fc {
    opacity: 0.55;
  }
  .t-bar {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    fill: #fff;
    pointer-events: none;
  }
  .lane-education .t-bar {
    fill: var(--ink);
  }
  .lane-industry .t-bar {
    fill: var(--paper);
  }
  .bar:hover rect:not(.bar-fc) {
    opacity: 0.82;
  }
  .mark-base {
    stroke: var(--hair);
    stroke-width: 1.5;
  }
  .diamond {
    fill: var(--signal);
  }
  .leader {
    stroke: var(--ink-3);
    stroke-width: 1;
    stroke-dasharray: 2 2;
  }
  .mark:hover .t-mark {
    fill: var(--signal);
  }
  .now-line {
    stroke: var(--signal);
    stroke-width: 1.5;
  }
  .xhair line {
    stroke: var(--signal);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }
  .xhair {
    opacity: 0;
    pointer-events: none;
  }
  .xhair.on {
    opacity: 1;
  }
  .readout {
    position: absolute;
    top: 52px;
    z-index: 2;
    min-width: 220px;
    max-width: 320px;
    padding: 10px 12px 12px;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    pointer-events: none;
  }
  .r-date {
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--signal);
    margin-bottom: 6px;
  }
  .r-list {
    display: grid;
    gap: 4px;
  }
  .r-list :global(li) {
    position: relative;
    padding-left: 16px;
    font-size: 13.5px;
    line-height: 1.35;
  }
  .r-list :global(li)::before {
    content: "";
    position: absolute;
    left: 0;
    top: 4px;
    width: 9px;
    height: 9px;
    background: var(--dot, var(--ink));
  }
  .r-list :global(li[data-lane="education"])::before {
    background: var(--paper);
    border: 1.5px solid var(--ink);
  }
  .r-list :global(li[data-lane="mark"])::before {
    background: var(--signal);
    transform: rotate(45deg) scale(0.8);
  }
  .r-list :global(li[data-lane="none"])::before {
    background: transparent;
    border: 1px dashed var(--ink-3);
  }
  .caption {
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.6;
    color: var(--ink-3);
    max-width: 90ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .bar rect:not(.bar-fc) {
      transform-box: fill-box;
      transform-origin: left center;
      animation: grow 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .lane-industry rect:not(.bar-fc) {
      animation-delay: 0.15s;
    }
    .lane-products rect:not(.bar-fc) {
      animation-delay: 0.3s;
    }
    .bar-fc,
    .diamond,
    .t-bar {
      animation: appear 0.5s ease 0.8s both;
    }
  }
  @keyframes grow {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes appear {
    from {
      opacity: 0;
    }
  }
</style>
