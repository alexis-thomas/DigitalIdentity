---
import { experience } from "../data/profile";
import { formatMonth, duration, md } from "../lib/format";
---

<div class="xp">
  {
    experience.map((e) => {
      const first = e.roles[e.roles.length - 1].start;
      const last = e.roles[0].end;
      return (
        <section class="employer" data-reveal>
          <header class="emp-head">
            <h3 class="hl emp-name">{e.company}</h3>
            <p class="label">
              {e.type ? `${e.type} · ` : ""}
              {duration(first, last)}
            </p>
          </header>
          <ol class="roles">
            {e.roles.map((r) => (
              <li class="role">
                <p class="when mono">
                  <time datetime={r.start}>{formatMonth(r.start)}</time> – {r.end ? <time datetime={r.end}>{formatMonth(r.end)}</time> : <span class="signal">Present</span>}
                  <span class="where">{r.location}</span>
                </p>
                <div class="what">
                  <h4 class="h3">{r.title}</h4>
                  <ul class="pts">
                    {r.bullets.map((b) => (
                      <li set:html={md(b)} />
                    ))}
                  </ul>
                  {r.stack && (
                    <ul class="tags">
                      {r.stack.map((s) => (
                        <li>{s}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      );
    })
  }
</div>

<style>
  .xp {
    display: grid;
    gap: 36px;
  }
  .emp-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 10px;
    border-bottom: 1.5px solid var(--rule);
  }
  .emp-name {
    font-size: clamp(34px, 4vw, 48px);
  }
  .role {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--hair);
  }
  .when {
    font-size: 13px;
    color: var(--ink-2);
    line-height: 1.6;
  }
  .where {
    display: block;
    color: var(--ink-3);
  }
  .what .h3 {
    margin-bottom: 10px;
  }
  .pts {
    display: grid;
    gap: 8px;
    margin-bottom: 14px;
  }
  .pts li {
    position: relative;
    padding-left: 20px;
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .pts li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 9px;
    height: 1.5px;
    background: var(--signal);
  }
  .pts :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .role {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .where {
      display: inline;
      margin-left: 8px;
    }
  }
  @media print {
    .xp {
      gap: 12pt;
    }
    .role {
      grid-template-columns: 110pt 1fr;
      padding: 6pt 0;
      break-inside: avoid;
    }
    .pts li {
      font-size: 10pt;
    }
    .emp-name {
      font-size: 20pt;
    }
  }
</style>
