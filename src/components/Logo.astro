---
// Brand mark: an ink square with a history line that continues as a dashed forecast.
// Also used (as a static file) for favicon.svg.
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="logo">
  <rect width="32" height="32" fill="var(--ink)"></rect>
  <path d="M5 22 L10.5 16.5 L14.5 19.5 L18.5 12.5" fill="none" stroke="var(--paper)" stroke-width="2.6" stroke-linecap="square" stroke-linejoin="miter"></path>
  <path d="M18.5 12.5 L27 7.5" fill="none" stroke="var(--signal)" stroke-width="2.6" stroke-dasharray="2.6 2.6"></path>
  <rect x="16.4" y="10.4" width="4.2" height="4.2" fill="var(--signal)"></rect>
</svg>

<style>
  .logo {
    flex: none;
  }
</style>
