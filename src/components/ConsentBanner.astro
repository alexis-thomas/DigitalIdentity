---
// A small banner, shown once in the EEA, the UK and Switzerland (from the browser's time zone and
// language, a best guess; Consent Mode keeps analytics cookies off there until a choice is made).
// The choice is kept in localStorage and can be changed on /privacy.
---

<div class="consent" data-consent hidden role="region" aria-label="Analytics cookies">
  <p>
    I use analytics cookies to see which pages are read. No ads, nothing sold.
    <a href="/privacy">Privacy</a>
  </p>
  <div class="actions">
    <button type="button" data-consent-choice="denied" class="ghost">No thanks</button>
    <button type="button" data-consent-choice="granted">OK</button>
  </div>
</div>

<script is:inline>
  (function () {
    var box = document.querySelector("[data-consent]");
    if (!box) return;
    var saved = null;
    try {
      saved = localStorage.getItem("consent");
    } catch (e) {}
    var tz = "";
    try {
      tz = Intl.DateTimeFormat().resolvedOptions().timeZone || "";
    } catch (e) {}
    // Europe/* covers the EEA, the UK and Switzerland (and a few others: asking there is harmless).
    var europe = tz.indexOf("Europe/") === 0 || tz === "Atlantic/Reykjavik" || tz === "Atlantic/Canary" || tz === "Atlantic/Madeira" || tz === "Atlantic/Azores";
    if (saved || !europe) return;
    box.hidden = false;
    box.addEventListener("click", function (ev) {
      var choice = ev.target && ev.target.getAttribute && ev.target.getAttribute("data-consent-choice");
      if (!choice) return;
      try {
        localStorage.setItem("consent", choice);
      } catch (e) {}
      if (window.gtag) window.gtag("consent", "update", { analytics_storage: choice });
      box.hidden = true;
    });
  })();
</script>

<style>
  .consent {
    position: fixed;
    inset: auto 16px 16px 16px;
    z-index: 50;
    max-width: 560px;
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    padding: 14px 18px;
    background: var(--paper);
    color: var(--ink);
    border: 2px solid var(--ink);
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.45;
  }
  .consent[hidden] {
    display: none;
  }
  .consent p {
    flex: 1 1 260px;
    margin: 0;
  }
  .consent a {
    color: inherit;
  }
  .actions {
    display: flex;
    gap: 10px;
  }
  button {
    font: inherit;
    font-weight: 650;
    padding: 8px 16px;
    border: 2px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
  }
  button.ghost {
    background: transparent;
    color: var(--ink);
  }
</style>
