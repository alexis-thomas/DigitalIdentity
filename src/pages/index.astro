---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import CareerChart from "../components/CareerChart.astro";
import ProjectBand from "../components/ProjectBand.astro";
import photo from "../assets/alexis.jpeg";
import { profile, highlights, experience, education, certifications, publications, awards, interests } from "../data/profile";
import { projects } from "../data/projects";
import { formatMonth, duration } from "../lib/format";

const title = "Alexis Thomas – Applied Scientist & ML Engineer, London";
const description =
  "Alexis Thomas, Applied Scientist at Amazon in London: demand forecasting, machine learning and AWS cloud architecture, plus AI apps used on 24K+ devices.";

const paper = publications.find((p) => p.public)!;
const award = awards[0];
const cert = certifications[0];

const pillars = [
  {
    key: "A",
    kicker: "Applied science",
    title: "Forecasts that survive production",
    body: "Hierarchical, neural, statistical and foundation-model forecasting for business-critical planning: rigorously evaluated, robust to volatility, and built to respect hard business constraints.",
    tags: ["Time series", "Hierarchical models", "Optimization", "Evaluation"],
  },
  {
    key: "B",
    kicker: "Engineering",
    title: "Cloud systems that scale",
    body: "Working with AWS since 2020: serverless platforms that run thousands of concurrent model executions at Amazon. AWS Certified Solutions Architect – Professional.",
    tags: ["AWS", "Serverless", "CDK", "Python", "Java", "TypeScript"],
  },
  {
    key: "C",
    kicker: "Product",
    title: "AI apps, end to end",
    body: "Three AI-powered apps designed, built and shipped on my own time, used on 24K+ devices in 68+ countries.",
    tags: ["LLMs", "React Native", "Next.js", "Design"],
  },
];

const rows = experience.flatMap((e) => e.roles.map((r) => ({ ...r, company: e.company, type: e.type })));
---

<Base title={title} description={description} pageType="ProfilePage">
  <!-- ============================== HERO ============================== -->
  <section class="hero graph-paper">
    <div class="wrap">
      <div class="hero-meta">
        <p class="label">Applied Scientist · ML Engineer · Software Engineer · London</p>
        <p class="status">{profile.role} at {profile.company}</p>
      </div>

      <h1 class="hl hero-name">Alexis Thomas</h1>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="lede">
            I build the <mark>demand forecasts</mark> that help Amazon plan its European delivery network, from three-year capacity plans
            down to zip-code-level operations. On my own time, I design, build and ship <mark>AI products</mark> end to end.
          </p>
          <div class="hero-cta">
            <a class="btn btn-solid" href="/resume"><Icon name="file" />Résumé</a>
            <a class="btn" href="#work">Selected work<Icon name="arrowRight" /></a>
          </div>
          <ul class="hero-links label">
            <li><a href={profile.social.linkedin} target="_blank" rel="me noopener">LinkedIn ↗</a></li>
            <li><a href={profile.social.github} target="_blank" rel="me noopener">GitHub ↗</a></li>
            <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          </ul>
        </div>
        <figure class="portrait">
          <Picture
            src={photo}
            formats={["avif"]}
            fallbackFormat="webp"
            widths={[240, 360, 480, 720]}
            sizes="(max-width: 860px) 160px, 300px"
            alt={profile.photoAlt}
            loading="eager"
            fetchpriority="high"
          />
          <figcaption class="label">Fig. 0 · {profile.locality}, {new Date().getFullYear()}</figcaption>
        </figure>
      </div>

      <div class="chart-block">
        <CareerChart />
      </div>
    </div>
  </section>

  <!-- ============================ FIGURES ============================= -->
  <section class="wrap figures-wrap" aria-label="Highlights">
    <ul class="figures">
      {
        highlights.map((h) => (
          <li>
            <p class="fig-value">{h.value}</p>
            <p class="fig-label">{h.label}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ========================== WHAT I DO ============================= -->
  <section class="section wrap" aria-labelledby="s1">
    <header class="sec-head">
      <p class="sec-num">§ 01 · What I do</p>
      <h2 id="s1" class="hl h2">Part scientist,<br />part engineer.</h2>
      <p class="sec-meta">Science · Engineering · Product</p>
    </header>
    <div class="pillars">
      {
        pillars.map((p) => (
          <article class="pillar" data-reveal>
            <p class="pillar-key">
              <span class="hl">{p.key}</span>
              <span class="label">{p.kicker}</span>
            </p>
            <h3 class="h3">{p.title}</h3>
            <p class="pillar-body serif">{p.body}</p>
            <ul class="tags">
              {p.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ======================== SELECTED WORK =========================== -->
  <section id="work" aria-labelledby="s2">
    <div class="wrap">
      <header class="sec-head">
        <p class="sec-num">§ 02 · Selected work</p>
        <h2 id="s2" class="hl h2">Products I've<br />built & shipped.</h2>
        <p class="sec-meta">
          {projects.length} products · 2023–{new Date().getFullYear()} · <a href="/projects">All projects →</a>
        </p>
      </header>
    </div>
    <div class="bands">
      {projects.map((p, i) => <ProjectBand project={p} index={i} />)}
    </div>
  </section>

  <!-- ========================== EXPERIENCE ============================ -->
  <section class="section wrap" aria-labelledby="s3">
    <header class="sec-head">
      <p class="sec-num">§ 03 · Experience</p>
      <h2 id="s3" class="hl h2">Engineer to<br />scientist.</h2>
      <p class="sec-meta">{duration("2022-03")} at Amazon · <a href="/resume">Full résumé →</a></p>
    </header>

    <div class="xp-intro">
      <p class="lede">
        Promoted from Software Development Engineer to SDE II at Amazon, then moved into applied science to own the forecasting models
        themselves.
      </p>
    </div>

    <table class="xp-table">
      <caption class="sr-only">Work experience and education</caption>
      <thead>
        <tr>
          <th scope="col">Period</th>
          <th scope="col">Role</th>
          <th scope="col">Organisation</th>
          <th scope="col" class="col-loc">Location</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr class:list={{ current: !r.end }}>
              <td class="mono">
                {formatMonth(r.start)} – {r.end ? formatMonth(r.end) : "now"}
              </td>
              <th scope="row">
                {r.title}
                {r.summary && <span class="row-sub">{r.summary}</span>}
              </th>
              <td>
                {r.company}
                {r.type && <span class="muted"> · {r.type}</span>}
              </td>
              <td class="col-loc muted">{r.location}</td>
            </tr>
          ))
        }
        <tr class="sub-head">
          <td colspan="4" class="label">Education</td>
        </tr>
        {
          education.map((e) => (
            <tr>
              <td class="mono">
                {e.start} – {e.end}
              </td>
              <th scope="row">{e.degree}</th>
              <td>{e.school}</td>
              <td class="col-loc muted">{e.location}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <!-- =========================== RESEARCH ============================= -->
  <section class="section wrap" aria-labelledby="s4">
    <header class="sec-head">
      <p class="sec-num">§ 04 · Research & recognition</p>
      <h2 id="s4" class="hl h2">Published, ranked,<br />certified.</h2>
      <p class="sec-meta"><a href="/research">Research page →</a></p>
    </header>
    <div class="research-grid">
      <article class="citation" data-reveal>
        <p class="label">Peer-reviewed · DMLR · {paper.year}</p>
        <h3 class="cite-title">“{paper.title}”</h3>
        <p class="cite-authors" set:html={paper.authors!.replace("A. Thomas", "<strong>A. Thomas</strong>")} />
        <p class="cite-venue">{paper.venue}, {paper.year}.</p>
        <div class="cite-links">
          {
            paper.links!.map((l) => (
              <a class="arrow-link" href={l.url} target="_blank" rel="noopener">
                {l.label}
                <Icon name="arrowUpRight" />
              </a>
            ))
          }
        </div>
      </article>
      <ul class="recog">
        <li data-reveal>
          <p class="label">Award · {formatMonth(award.date)}</p>
          <p class="recog-title">{award.title}</p>
          <p class="muted serif">EV charging forecasting, reviewed by a jury including Cédric Villani.</p>
        </li>
        <li data-reveal>
          <p class="label">Certification · {formatMonth(cert.date)}</p>
          <p class="recog-title">{cert.name}</p>
          <a class="arrow-link" href={cert.url} target="_blank" rel="noopener">Verify<Icon name="arrowUpRight" /></a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============================= ABOUT ============================== -->
  <section class="section wrap" id="about" aria-labelledby="s5">
    <header class="sec-head">
      <p class="sec-num">§ 05 · About</p>
      <h2 id="s5" class="hl h2">The person<br />behind the plots.</h2>
    </header>
    <div class="about-grid">
      <div class="prose about-text" data-reveal>
        <p class="first">{profile.shortBio}</p>
        {profile.longBio.map((p) => <p>{p}</p>)}
      </div>
      <dl class="facts">
        <div><dt class="label">Based in</dt><dd>{profile.location}</dd></div>
        <div><dt class="label">Languages</dt><dd>{profile.languages.map((l) => `${l.name} (${l.level.toLowerCase()})`).join(", ")}</dd></div>
        <div><dt class="label">Education</dt><dd>Mines Paris – PSL</dd></div>
        <div><dt class="label">Off the clock</dt><dd>{interests.join(", ")}</dd></div>
      </dl>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    padding-top: clamp(20px, 3vw, 36px);
    padding-bottom: clamp(28px, 4vw, 48px);
    border-bottom: 1px solid var(--rule);
  }
  .hero-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
  }
  .hero-name {
    /* Sized so the full name spans the content width on one line. */
    font-size: calc((min(100vw, var(--max)) - 2 * var(--gutter)) / 5.9);
    font-stretch: 62%;
    line-height: 0.8;
    margin: clamp(18px, 3vw, 34px) 0 clamp(20px, 3vw, 36px);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(24px, 5vw, 72px);
    align-items: start;
  }
  .hero-copy .lede {
    max-width: 34em;
    font-size: clamp(21px, 2.3vw, 28px);
  }
  mark {
    background: none;
    color: inherit;
    box-shadow: inset 0 -0.32em 0 var(--signal-soft), inset 0 -2px 0 var(--signal);
    padding: 0 1px;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 28px 0 18px;
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
  }
  .hero-links a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--hair);
  }
  .hero-links a:hover {
    color: var(--signal);
    border-color: var(--signal);
  }
  .portrait {
    width: clamp(160px, 22vw, 300px);
  }
  .portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 28%;
    border: 1.5px solid var(--ink);
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.4s;
  }
  .portrait:hover :global(img) {
    filter: none;
  }
  .portrait figcaption {
    margin-top: 8px;
    font-size: 11px;
  }
  .chart-block {
    margin-top: clamp(40px, 6vw, 72px);
    padding-top: 18px;
    border-top: 1px solid var(--rule);
  }

  .figures-wrap {
    padding-top: clamp(40px, 6vw, 64px);
  }

  /* ---------- pillars ---------- */
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--rule);
  }
  .pillar {
    padding: 22px 26px 6px;
    border-left: 1px solid var(--hair);
    display: flex;
    flex-direction: column;
  }
  .pillar:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .pillar-key {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 18px;
  }
  .pillar-key .hl {
    font-size: 54px;
    color: var(--signal);
  }
  .pillar .h3 {
    margin-bottom: 10px;
  }
  .pillar-body {
    font-size: 17.5px;
    line-height: 1.55;
    color: var(--ink-2);
    margin-bottom: 18px;
    flex: 1;
  }

  /* ---------- bands ---------- */
  .bands {
    border-bottom: 1px solid var(--rule);
  }

  /* ---------- experience ---------- */
  .xp-intro {
    max-width: 44em;
    margin-bottom: 28px;
  }
  .xp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15.5px;
  }
  .xp-table thead th {
    text-align: left;
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding: 0 16px 10px 0;
    border-bottom: 1.5px solid var(--rule);
  }
  .xp-table td,
  .xp-table tbody th {
    text-align: left;
    vertical-align: top;
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--hair);
  }
  .xp-table td.mono {
    font-size: 13px;
    white-space: nowrap;
    color: var(--ink-2);
    width: 190px;
  }
  .xp-table tbody th {
    font-weight: 650;
  }
  .row-sub {
    display: block;
    margin-top: 4px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 15.5px;
    color: var(--ink-2);
  }
  .xp-table tr.current td.mono {
    color: var(--signal);
  }
  .xp-table tr.current td.mono::before {
    content: "■ ";
  }
  .sub-head td {
    padding-top: 28px !important;
    border-bottom: 1.5px solid var(--rule) !important;
  }

  /* ---------- research ---------- */
  .research-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
  }
  .citation {
    padding: 26px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .cite-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.18;
    letter-spacing: -0.01em;
    margin: 14px 0 14px;
  }
  .cite-authors {
    font-family: var(--serif);
    font-size: 16px;
    color: var(--ink-2);
    margin-bottom: 4px;
  }
  .cite-venue {
    font-family: var(--serif);
    font-style: italic;
    font-size: 16px;
    color: var(--ink-2);
    margin-bottom: 20px;
  }
  .cite-links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
  }
  .recog {
    border-top: 1px solid var(--rule);
  }
  .recog li {
    padding: 18px 0;
    border-bottom: 1px solid var(--hair);
  }
  .recog-title {
    font-weight: 650;
    font-size: 18px;
    line-height: 1.3;
    margin: 6px 0;
  }
  .recog-title.small {
    font-size: 15.5px;
    font-weight: 500;
  }
  .recog .serif {
    font-size: 16px;
  }

  /* ---------- about ---------- */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }
  .about-text {
    columns: 2;
    column-gap: 36px;
  }
  .about-text p {
    break-inside: avoid-column;
  }
  .first {
    color: var(--ink);
  }
  .first::first-line {
    font-weight: 600;
  }
  .facts {
    border-top: 1px solid var(--rule);
  }
  .facts div {
    padding: 12px 0;
    border-bottom: 1px solid var(--hair);
    display: grid;
    gap: 4px;
  }
  .facts dd {
    font-size: 15.5px;
  }

  @media (max-width: 960px) {
    .pillars {
      grid-template-columns: 1fr;
    }
    .pillar {
      border-left: 0;
      padding-left: 0;
      border-bottom: 1px solid var(--hair);
      padding-bottom: 22px;
    }
    .research-grid,
    .about-grid {
      grid-template-columns: 1fr;
    }
    .col-loc {
      display: none;
    }
  }
  @media (min-width: 961px) {
    .col-loc {
      white-space: nowrap;
    }
  }
  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      order: -1;
    }
    .hero-name {
      white-space: normal;
      font-size: clamp(72px, 29vw, 170px);
    }
  }
  @media (max-width: 640px) {
    .about-text {
      columns: 1;
    }
    .xp-table thead {
      display: none;
    }
    .xp-table tr {
      display: grid;
      grid-template-columns: 1fr;
      padding: 12px 0;
      border-bottom: 1px solid var(--hair);
    }
    .xp-table td,
    .xp-table tbody th {
      padding: 2px 0;
      border: 0;
    }
    .xp-table td.mono {
      width: auto;
    }
  }
</style>
