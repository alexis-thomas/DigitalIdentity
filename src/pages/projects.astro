---
import Base from "../layouts/Base.astro";
import ProjectBand from "../components/ProjectBand.astro";
import { projects } from "../data/projects";
import { SITE_URL } from "../data/profile";

const title = "Projects: AI Apps Built & Shipped | Alexis Thomas";
const description =
  "Case studies of Prismo, Giftruly and Aura: AI-powered apps for iOS, Android and the web that Alexis Thomas designed, built and runs on serverless AWS.";

const itemList = {
  "@type": "ItemList",
  itemListElement: projects.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: `${SITE_URL}/projects/${p.slug}`,
    name: p.name,
  })),
};
---

<Base title={title} description={description} og="projects" pageType="CollectionPage" breadcrumbs={[{ name: "Projects", path: "/projects" }]} schema={[itemList]}>
  <section class="intro graph-paper">
    <div class="wrap">
      <p class="label signal">§ Projects · {projects.length} case studies</p>
      <h1 class="hl title">Things<br />I've built.</h1>
      <div class="intro-grid">
        <p class="lede">
          Alongside my work at Amazon, I build products end to end: the product thinking, the design, the mobile and web apps, the
          serverless backends and the LLM pipelines, all the way to the App Store.
        </p>
        <ol class="toc">
          {
            projects.map((p, i) => (
              <li>
                <a href={`/projects/${p.slug}`}>
                  <span class="label">P/{String(i + 1).padStart(2, "0")}</span>
                  <span class="toc-name">{p.name}</span>
                  <span class="label toc-status">{p.status}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>
  <div class="bands">
    {projects.map((p, i) => <ProjectBand project={p} index={i} headingLevel="h2" eager={i === 0} />)}
  </div>
</Base>

<style>
  .intro {
    padding-block: clamp(36px, 6vw, 72px);
  }
  .title {
    font-size: clamp(76px, 13vw, 200px);
    line-height: 0.8;
    margin: 18px 0 clamp(28px, 4vw, 48px);
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(24px, 5vw, 72px);
    align-items: end;
  }
  .toc {
    border-top: 1.5px solid var(--rule);
  }
  .toc a {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    align-items: baseline;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--hair);
    text-decoration: none;
  }
  .toc-name {
    font-family: var(--display);
    font-weight: 820;
    font-stretch: 70%;
    font-size: 30px;
    text-transform: uppercase;
    line-height: 1;
  }
  .toc a:hover .toc-name {
    color: var(--signal);
  }
  .bands {
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 860px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
    .toc-status {
      display: none;
    }
  }
</style>
